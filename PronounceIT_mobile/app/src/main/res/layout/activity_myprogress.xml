<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/testbackground">

    <!-- Back Button (Top Left) -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/yellow_violet_back_button"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back_purple"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:elevation="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/progressImage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/progress"
        android:contentDescription="Progress Image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Achievements Button -->
    <Button
        android:id="@+id/achievementsButton"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Achievements"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/game_button_primary"
        android:padding="12dp"
        android:fontFamily="@font/wonderbar"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/progressImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- View Scores Button -->
    <Button
        android:id="@+id/viewScoresButton"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/game_button_primary"
        android:fontFamily="@font/wonderbar"
        android:padding="12dp"
        android:stateListAnimator="@null"
        android:text="View Scores"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/achievementsButton" />

</androidx.constraintlayout.widget.ConstraintLayout>