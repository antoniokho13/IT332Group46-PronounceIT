<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/image_border_yellow">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exit Game?"
            android:textSize="24sp"
            android:textColor="@color/primary_text"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />

        <!-- Message -->
        <TextView
            android:id="@+id/exitMessageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Are you sure you want to exit the game?\nYour progress will not be saved."
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="32dp"
            android:fontFamily="sans-serif-medium"
            android:alpha="0.8" />

        <!-- Button Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <!-- Exit Button (Red) -->
            <Button
                android:id="@+id/exitBackButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Exit"
                android:textColor="@color/white"
                android:background="@drawable/game_button_tertiary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false" />

            <!-- Continue Button (Green) -->
            <Button
                android:id="@+id/continueGameButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Continue"
                android:textColor="@color/white"
                android:background="@drawable/game_button_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>