<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@drawable/background5"
    tools:context=".WordActivity">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:background="@drawable/circle_button_background"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        android:scaleType="centerInside"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/buttonContainer"
        android:layout_marginBottom="-80dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">


        <TextView
            android:id="@+id/lessonNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#33FFFFFF"
            android:elevation="4dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:padding="6dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="Lesson: "
            android:textColor="#1C2826"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wordTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/curved_word_background"
            android:elevation="6dp"
            android:fontFamily="@font/nunito"
            android:includeFontPadding="true"
            android:padding="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="5"
            android:shadowRadius="4"
            android:text="Word"
            android:textColor="#1C2826"
            android:textSize="45sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scoreTrackerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="#33FFFFFF"
                android:fontFamily="@font/nunito"
                android:padding="6dp"
                android:text="Score: 0/0"
                android:textColor="#1C2826"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wordCounterTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33FFFFFF"
                android:fontFamily="@font/nunito"
                android:padding="6dp"
                android:text="Word: 1/10"
                android:textColor="#1C2826"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/attemptCounterTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF"
            android:elevation="4dp"
            android:fontFamily="@font/nunito"
            android:padding="6dp"
            android:text="Attempts left: 5"
            android:textColor="#1C2826"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Feedback TextView for "Correct!" or "Try again!" messages -->
        <TextView
            android:id="@+id/feedbackTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#33FFFFFF"
            android:elevation="6dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:padding="12dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text=""
            android:textColor="#00FF00"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />


        <FrameLayout
            android:id="@+id/imageFrameLayout"
            android:layout_width="319dp"
            android:layout_height="331dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/animated_image_border"
            android:padding="12dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white">

                <ImageView
                    android:id="@+id/wordImageView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="Word image"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <nl.dionsegijn.konfetti.KonfettiView
                    android:id="@+id/konfettiView"
                    android:layout_width="283dp"
                    android:layout_height="296dp"
                    tools:layout_editor_absoluteX="2dp"
                    tools:layout_editor_absoluteY="2dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/playAudioButton"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:background="@drawable/game_button_primary"
                android:contentDescription="Play Audio"
                android:fontFamily="@font/wonderbar"
                android:stateListAnimator="@null"
                android:text="PLAY SOUND"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/nextWordButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@android:color/transparent"
                android:contentDescription="Next Word"
                android:onClick="nextWord"
                android:scaleType="fitCenter"
                android:src="@drawable/nextbutton"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingBottom="0dp">

        <!-- Curved "Press Me" text above the mic button -->
        <com.example.pronounceit.CurvedTextView
            android:id="@+id/curvedTextView"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="top|center_horizontal"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/recordingIndicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recording..."
            android:textColor="#F3AD00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="110dp"
            android:background="#33FFFFFF"
            android:padding="8dp"
            android:fontFamily="@font/nunito"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/recordPronunciationButton"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@android:color/transparent"
            android:contentDescription="Record pronunciation"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone" />

        <ImageButton
            android:id="@+id/stopRecordingButton"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@android:color/transparent"
            android:contentDescription="Stop recording"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone"
            android:visibility="gone" />
    </FrameLayout>

</RelativeLayout>