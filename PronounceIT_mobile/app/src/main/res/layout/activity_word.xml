<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@drawable/background5"
    tools:context=".WordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_above="@id/buttonContainer"
        android:padding="16dp">

        <!-- Add spacing at top to push content down -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <TextView
            android:id="@+id/lessonNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:text="Lesson: "
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF"
            android:padding="8dp"
            android:elevation="4dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:gravity="center"
            android:fontFamily="@font/nunito"/>

        <TextView
            android:id="@+id/wordTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="45sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:text="Word"
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF"
            android:padding="16dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:elevation="6dp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:fontFamily="@font/nunito"
            android:includeFontPadding="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/scoreTrackerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0/0"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="#33FFFFFF"
                android:padding="8dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/nunito"/>

            <TextView
                android:id="@+id/wordCounterTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word: 1/10"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="#33FFFFFF"
                android:padding="8dp"
                android:fontFamily="@font/nunito"/>
        </LinearLayout>

        <TextView
            android:id="@+id/attemptCounterTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attempts left: 5"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"
            android:background="#33FFFFFF"
            android:padding="8dp"
            android:elevation="4dp"
            android:fontFamily="@font/nunito"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/wordImageView"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="@drawable/kid_friendly_image_border"
            android:padding="12dp" />

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/playAudioButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/playaudio"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:contentDescription="Play Audio" />

            <ImageButton
                android:id="@+id/nextWordButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nextbutton"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:onClick="nextWord"
                android:contentDescription="Next Word"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Microphone button container at the absolute bottom -->
    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <!-- Record button with microphone image -->
        <ImageButton
            android:id="@+id/recordPronunciationButton"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@android:color/transparent"
            android:contentDescription="Record pronunciation"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone" />

        <!-- Stop recording button with stop icon -->
        <ImageButton
            android:id="@+id/stopRecordingButton"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@android:color/transparent"
            android:contentDescription="Stop recording"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone"
            android:visibility="gone"
            app:tint="#FF0000" />
    </FrameLayout>
</RelativeLayout>