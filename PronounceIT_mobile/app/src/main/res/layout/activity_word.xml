<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@drawable/background5"
    tools:context=".WordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_above="@id/buttonContainer"
        android:padding="16dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="15dp" />

        <TextView
            android:id="@+id/lessonNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#F3AD00"
            android:text="Lesson: "
            android:layout_marginBottom="8dp"
            android:background="#33FFFFFF"
            android:padding="6dp"
            android:elevation="4dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:gravity="center"
            android:fontFamily="@font/nunito"/>

        <TextView
            android:id="@+id/wordTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#F3AD00"
            android:text="Word"
            android:layout_marginBottom="8dp"
            android:background="#33FFFFFF"
            android:padding="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="6dp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:fontFamily="@font/nunito"
            android:includeFontPadding="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/scoreTrackerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0/0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#F3AD00"
                android:background="#33FFFFFF"
                android:padding="6dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/nunito"/>

            <TextView
                android:id="@+id/wordCounterTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word: 1/10"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#F3AD00"
                android:background="#33FFFFFF"
                android:padding="6dp"
                android:fontFamily="@font/nunito"/>
        </LinearLayout>

        <TextView
            android:id="@+id/attemptCounterTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attempts left: 5"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#F3AD00"
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF"
            android:padding="6dp"
            android:elevation="4dp"
            android:fontFamily="@font/nunito"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"/>

        <FrameLayout
            android:id="@+id/imageFrameLayout"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:background="@drawable/animated_image_border"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white">

                <ImageView
                    android:id="@+id/wordImageView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Word image"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/playAudioButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/playaudio"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:contentDescription="Play Audio" />

            <ImageButton
                android:id="@+id/nextWordButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nextbutton"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:onClick="nextWord"
                android:contentDescription="Next Word"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingBottom="0dp">

        <!-- Curved "Press Me" text above the mic button -->
        <com.example.pronounceit.CurvedTextView
            android:id="@+id/curvedTextView"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="top|center_horizontal"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/recordingIndicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recording..."
            android:textColor="#F3AD00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="110dp"
            android:background="#33FFFFFF"
            android:padding="8dp"
            android:fontFamily="@font/nunito"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/recordPronunciationButton"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@android:color/transparent"
            android:contentDescription="Record pronunciation"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone" />

        <ImageButton
            android:id="@+id/stopRecordingButton"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@android:color/transparent"
            android:contentDescription="Stop recording"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone"
            android:visibility="gone" />
    </FrameLayout>

    <nl.dionsegijn.konfetti.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>