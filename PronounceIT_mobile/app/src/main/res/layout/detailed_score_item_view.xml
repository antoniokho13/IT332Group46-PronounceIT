<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/correct_item_background">

    <!-- Status Icon (Check or X) -->
    <ImageView
        android:id="@+id/statusIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_check"
        android:contentDescription="Status Icon"/>

    <!-- Lesson Info Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Lesson Name -->
        <TextView
            android:id="@+id/lessonNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lesson Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <!-- Details (Correct/Incorrect) -->
        <TextView
            android:id="@+id/detailsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correct: 0 | Incorrect: 0"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Score Percentage -->
    <TextView
        android:id="@+id/scoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100%"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:layout_marginStart="16dp"/>

</LinearLayout>