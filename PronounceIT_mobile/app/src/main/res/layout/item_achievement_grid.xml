<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/achievementIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:maxHeight="100dp"
        android:minHeight="70dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_achievement_default"
        android:contentDescription="Achievement Badge"
        android:padding="3dp" />
    <!-- Title shown under the icon -->
    <!-- Title hidden in grid per design (kept for accessibility if needed) -->
    <TextView
        android:id="@+id/achievementTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:text=""
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- status label removed; status is shown inside the details dialog instead -->

</FrameLayout>