<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Back Button (Top Left) -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/yellow_violet_back_button"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back_purple"
        android:scaleType="centerInside"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Show the user's total accumulated points below the title -->

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="176dp"
            android:adjustViewBounds="true"
            android:contentDescription="Achievements Header"
            android:src="@drawable/achievements" />

        <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/achievementsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>