<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- School background image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/school_background"
        android:scaleType="centerCrop"
        android:alpha="0.3" />

    <!-- Professional dialog container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Logout"
                android:textSize="24sp"
                android:textColor="@color/primary_text"
                android:textAlignment="center"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <!-- Message -->
            <TextView
                android:id="@+id/logoutMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Are you sure you want to logout?\nYou will need to sign in again to continue."
                android:textSize="16sp"
                android:textColor="@color/primary_text"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="32dp"
                android:fontFamily="sans-serif-medium"
                android:alpha="0.8" />

            <!-- Button Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <!-- Cancel Button (Green) -->
                <Button
                    android:id="@+id/cancelLogoutButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancel"
                    android:textColor="@color/white"
                    android:background="@drawable/game_button_primary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false" />

                <!-- Logout Button (Red) -->
                <Button
                    android:id="@+id/confirmLogoutButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Logout"
                    android:textColor="@color/white"
                    android:background="@drawable/game_button_tertiary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>