<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background4">

    <!-- Back Button (Top Left) -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="55dp"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:background="@drawable/yellow_violet_back_button"
        android:contentDescription="Back"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_arrow_back_purple"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Settings Image -->

            <!-- LinearLayout with buttons remains unchanged -->

            <ImageView
                android:id="@+id/settingsImage"
                android:layout_width="match_parent"
                android:layout_height="202dp"
                android:layout_marginTop="20dp"
                android:contentDescription="Settings"
                android:src="@drawable/settingsinfo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/settingsImage"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Edit User Profile Button -->
                <Button
                    android:id="@+id/editUserProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/game_button_primary"
                    android:fontFamily="@font/wonderbar"
                    android:padding="12dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:stateListAnimator="@null"
                    android:text="Edit User Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- My Progress Button -->
                <Button
                    android:id="@+id/myProgressButton"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/game_button_primary"
                    android:fontFamily="@font/wonderbar"
                    android:padding="12dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:stateListAnimator="@null"
                    android:text="My Progress"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Volume On/Off Button -->
                <Button
                    android:id="@+id/volumeToggleButton"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/game_button_primary"
                    android:fontFamily="@font/wonderbar"
                    android:padding="12dp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:stateListAnimator="@null"
                    android:text="Volume On/Off"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>