<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/background4">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Settings Image - now outside LinearLayout -->
        <ImageView
            android:id="@+id/settingsImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="40dp"
            android:adjustViewBounds="true"
            android:contentDescription="Settings"
            android:src="@drawable/settingsinfo" />

        <!-- LinearLayout with buttons remains unchanged -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_below="@id/settingsImage"
            android:layout_marginTop="20dp">

            <!-- My Progress Button - increased height and minWidth -->
            <Button
                android:id="@+id/myProgressButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="My Progress"
                android:textSize="18sp"
                android:padding="8dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/pushable_button_teal"
                android:textColor="#FFFFFF"
                android:minWidth="240dp"
                android:fontFamily="@font/wonderbar" />

            <!-- Edit User Profile Button - increased height and minWidth -->
            <Button
                android:id="@+id/editUserProfileButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Edit User Profile"
                android:textSize="18sp"
                android:padding="8dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/pushable_button_teal"
                android:textColor="#FFFFFF"
                android:minWidth="240dp"
                android:fontFamily="@font/wonderbar" />

            <!-- Volume On/Off Button - increased height and minWidth -->
            <Button
                android:id="@+id/volumeToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/pushable_button_teal"
                android:fontFamily="@font/wonderbar"
                android:minWidth="240dp"
                android:padding="8dp"
                android:text="Volume On/Off"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>