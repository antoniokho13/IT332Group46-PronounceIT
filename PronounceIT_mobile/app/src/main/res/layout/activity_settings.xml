<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/background4">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Settings Image -->
        <ImageView
            android:id="@+id/settingsImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="40dp"
            android:adjustViewBounds="true"
            android:contentDescription="Settings"
            android:src="@drawable/settingsinfo" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_below="@id/settingsImage"
            android:layout_marginTop="20dp">

            <!-- Edit User Profile Button moved to first position -->
            <Button
                android:id="@+id/editUserProfileButton"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="Edit User Profile"
                android:textSize="22sp"
                android:padding="8dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/rainbow_button"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textStyle="bold"
                android:fontFamily="@font/wonderbar"
                android:stateListAnimator="@null" />

            <!-- My Progress Button moved to second position -->
            <Button
                android:id="@+id/myProgressButton"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="My Progress"
                android:textSize="22sp"
                android:padding="8dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/rainbow_button"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textStyle="bold"
                android:fontFamily="@font/wonderbar"
                android:stateListAnimator="@null" />

            <!-- Volume On/Off Button remains in third position -->
            <Button
                android:id="@+id/volumeToggleButton"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/rainbow_button"
                android:fontFamily="@font/wonderbar"
                android:padding="8dp"
                android:text="Volume On/Off"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textSize="22sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>