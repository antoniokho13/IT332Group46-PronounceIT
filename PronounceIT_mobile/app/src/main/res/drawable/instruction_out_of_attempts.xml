<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/primary_color" />
        </shape>
    </item>
    
    <!-- Image area -->
    <item android:top="80dp" android:bottom="220dp" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/white" />
            <stroke android:width="3dp" android:color="#9C27B0" />
        </shape>
    </item>
    
    <!-- Apple -->
    <item android:top="100dp" android:bottom="240dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <solid android:color="@color/bright_red" />
        </shape>
    </item>
    
    <!-- "Out of attempts" feedback area -->
    <item android:top="40dp" android:bottom="70dp" android:left="30dp" android:right="150dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/bright_red" />
        </shape>
    </item>
    
    <!-- Out of attempts text representation -->
    <item android:top="48dp" android:bottom="62dp" android:left="40dp" android:right="140dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    
    <!-- Next button -->
    <item android:top="290dp" android:bottom="320dp" android:left="60dp" android:right="120dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/bright_orange" />
        </shape>
    </item>
    
    <!-- Attempts left: 0 indicator -->
    <item android:top="15dp" android:bottom="25dp" android:left="90dp" android:right="140dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>