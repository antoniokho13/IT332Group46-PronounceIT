<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#3B215F" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <gradient
                        android:startColor="#9C27B0"
                        android:centerColor="#BA68C8"
                        android:endColor="#9C27B0"
                        android:type="linear"
                        android:angle="270" />
                </shape>
            </item>
            <item android:top="3dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:startColor="#E1BEE7"
                        android:endColor="#9C27B0"
                        android:type="linear"
                        android:angle="135" />
                    <stroke android:width="1dp" android:color="#E1BEE7" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#3B215F" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <gradient
                        android:startColor="#9C27B0"
                        android:centerColor="#BA68C8"
                        android:endColor="#9C27B0"
                        android:type="linear"
                        android:angle="270" />
                </shape>
            </item>
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:startColor="#E1BEE7"
                        android:endColor="#9C27B0"
                        android:type="linear"
                        android:angle="135" />
                    <stroke android:width="1dp" android:color="#E1BEE7" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>