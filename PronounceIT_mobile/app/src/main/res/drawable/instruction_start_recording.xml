<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/primary_color" />
        </shape>
    </item>
    
    <!-- Image area -->
    <item android:top="40dp" android:bottom="180dp" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/white" />
            <stroke android:width="3dp" android:color="#9C27B0" />
        </shape>
    </item>
    
    <!-- Apple -->
    <item android:top="60dp" android:bottom="200dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <solid android:color="@color/bright_red" />
        </shape>
    </item>
    
    <!-- Microphone button (inactive) -->
    <item android:top="250dp" android:bottom="290dp" android:left="70dp" android:right="110dp">
        <shape android:shape="oval">
            <solid android:color="@color/bright_orange" />
        </shape>
    </item>
    
    <!-- Microphone icon -->
    <item android:top="265dp" android:bottom="275dp" android:left="85dp" android:right="95dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    
    <!-- Press instruction arrow -->
    <item android:top="220dp" android:bottom="240dp" android:left="40dp" android:right="50dp">
        <rotate android:fromDegrees="45">
            <shape android:shape="rectangle">
                <solid android:color="@color/white" />
            </shape>
        </rotate>
    </item>
</layer-list>