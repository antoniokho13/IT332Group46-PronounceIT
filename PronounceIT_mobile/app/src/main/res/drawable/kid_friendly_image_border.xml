<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Colorful outer border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="sweep"
                android:startColor="@color/bright_red"
                android:centerColor="@color/bright_yellow"
                android:endColor="@color/bright_blue" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp" />
        </shape>
    </item>

    <!-- White middle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp" />
        </shape>
    </item>

    <!-- Inner background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bright_yellow" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>