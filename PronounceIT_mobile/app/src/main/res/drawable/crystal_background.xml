<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base semi-transparent layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#88FFFFFF" />
        </shape>
    </item>

    <!-- Top highlight -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#99FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <size android:height="4dp" />
        </shape>
    </item>

    <!-- Right highlight -->
    <item android:right="1dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:endColor="#55FFFFFF"
                android:type="linear" />
            <size android:width="4dp" />
        </shape>
    </item>

    <!-- Inner border -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>