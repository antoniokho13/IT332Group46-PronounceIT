<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/primary_color" />
        </shape>
    </item>
    
    <!-- Image area -->
    <item android:top="40dp" android:bottom="180dp" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/white" />
            <stroke android:width="3dp" android:color="#9C27B0" />
        </shape>
    </item>
    
    <!-- Apple -->
    <item android:top="60dp" android:bottom="200dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <solid android:color="@color/bright_red" />
        </shape>
    </item>
    
    <!-- PLAY SOUND button -->
    <item android:top="200dp" android:bottom="240dp" android:left="60dp" android:right="60dp">
        <shape android:shape="oval">
            <solid android:color="@color/bright_green" />
        </shape>
    </item>
    
    <!-- Play icon -->
    <item android:top="215dp" android:bottom="225dp" android:left="75dp" android:right="85dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>